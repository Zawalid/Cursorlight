{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cursorlight",
  "compatibility_date": "2026-10-12",
  "workers_dev": false,
  "preview_urls": false,
  // Keep this host in step with DOMAIN in site.config.mjs (JSON cannot import it).
  "routes": [{ "pattern": "cursorlight.zawalid.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
