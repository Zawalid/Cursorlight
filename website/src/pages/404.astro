---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Page not found: Cursorlight" description="This page does not exist. Go back to the Cursorlight home page for the download and the install steps." noindex>
  <section class="nf" data-surface="dark">
    <div class="wrap">
      <h1 class="display">Lost your cursor?</h1>
      <p class="lead">That page does not exist. Shake the mouse, or head back to the start.</p>
      <p><a class="btn btn-ember" href="/">Back to the home page</a></p>
    </div>
  </section>
  <div class="nf-foot" data-surface="ember"><Footer /></div>
</Base>
