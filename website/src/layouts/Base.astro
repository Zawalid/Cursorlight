---
import '../styles/global.css';
import '../styles/sections.css';
import MenuBar from '../components/MenuBar.astro';
import Toolbar from '../components/Toolbar.astro';
import { site, links, version } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Path of the share image under /public. */
  image?: string;
  imageAlt?: string;
  /** Structured data for this page. */
  structuredData?: object[];
  /** A page that should not be indexed (the 404). */
  noindex?: boolean;
}
const {
  title = site.title,
  description = site.description,
  image = '/og.png',
  imageAlt = 'Cursorlight: be seen wherever you point. An ember pointer inside a ring on a dark background.',
  structuredData,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const ogImage = new URL(image, site.url).toString();

const appData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  description,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: `macOS ${site.minimumMacOS} or later`,
  softwareVersion: version,
  url: site.url,
  downloadUrl: links.download,
  license: 'https://opensource.org/license/mit',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Person', name: 'Walid Zakan', url: links.author },
  codeRepository: links.repo,
};
const jsonLd = structuredData ?? [appData];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#14121a" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href="/fonts/MonaSans-var.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var m = window.matchMedia;
        if (!m || m('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('motion');
        // The pointer playground needs a real mouse; touch and reduced motion get the calm, static version.
        if (m('(hover: hover) and (pointer: fine) and (min-width: 760px)').matches) d.classList.add('live');
        // If the animation module never starts, fall back to the static layout.
        setTimeout(function () { if (!window.__cursorlightMotion) d.classList.remove('motion', 'live'); }, 6000);
      })();
    </script>
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to the content</a>

    <MenuBar />

    <main id="main"><slot /></main>

    <canvas class="fx-canvas" aria-hidden="true" data-fx-canvas></canvas>
    <Toolbar />

    <script>
      import '../scripts/main';
    </script>

  </body>
</html>
