---
import Shot from './Shot.astro';

const rows = [
  ['Accessibility', 'Not used.'],
  ['Screen Recording', 'Not needed. Cursorlight draws on your screen, it never reads it.'],
  ['Input Monitoring', 'Optional. Only for the keystroke display, hold-a-key triggers, the key sound and hide-while-typing. Everything else works without it.'],
  ['Password fields', 'Never seen. The system withholds those keys.'],
  ['Network', 'Nothing, except an update check you can leave off.'],
  ['Accounts and analytics', 'None.'],
];
---
<section class="section privacy" id="privacy" aria-labelledby="privacy-title" data-surface="dark">
  <div class="wrap">
    <h2 id="privacy-title" class="statement" data-statement>A pointer tool has no business knowing anything about you. It does not.</h2>
    <div class="privacy-grid">
      <dl class="perm">
        {rows.map(([k, v]) => (
          <div class="p-row" data-reveal><dt>{k}</dt><dd>{v}</dd></div>
        ))}
      </dl>
      <figure class="about" data-reveal>
        <Shot id="about-privacy" sizes="(min-width: 1000px) 460px, 92vw" widths={[640, 1340]} />
        <figcaption>The app's own About page says the same.</figcaption>
      </figure>
    </div>
    <p class="note" data-reveal>The app has no analytics. This website counts visits with Cloudflare Web Analytics: no cookies, no personal data, and nothing is collected from visitors in the EU.</p>
  </div>
</section>
