---
import { faq } from '../data/faq';
---
<section class="section faq" id="faq" aria-labelledby="faq-title" data-surface="dark">
  <div class="wrap faq-grid">
    <h2 id="faq-title" class="h2" data-reveal>Questions.</h2>
    <div class="list">
      {faq.map((item) => (
        <details data-faq>
          <summary><span>{item.q}</span><span class="faq-plus" aria-hidden="true"></span></summary>
          <div class="a"><p>{item.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>
