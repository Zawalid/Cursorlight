---
import { Image } from 'astro:assets';
import { shots, shotImage, cropImage, cropAlt, type ShotId, type CropId } from '../data/shots';

interface Props {
  /** A full capture from shots.ts, or a crop from crop-defs.json. */
  id: ShotId | CropId;
  /** Responsive sizes hint for the browser, so phones are not sent the largest file. */
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
  alt?: string;
  widths?: number[];
}
const { id, sizes = '(min-width: 1320px) 1320px, 92vw', loading = 'lazy', class: className, alt, widths = [640, 960, 1440, 2000] } = Astro.props;
const isShot = id in shots;
const image = isShot ? shotImage(id as ShotId) : cropImage(id as CropId);
const text = alt ?? (isShot ? shots[id as ShotId].alt : cropAlt[id as CropId]);
const brief = isShot ? shots[id as ShotId].brief : String(id);
const file = isShot ? shots[id as ShotId].file : `crops/${id}.webp`;
const ratio = isShot ? shots[id as ShotId].ratio : ([16, 10] as [number, number]);
---
{image ? (
  <Image src={image} alt={text} widths={widths} sizes={sizes} loading={loading} decoding="async" format="webp" quality={88} class={className} />
) : (
  <div class:list={['ph', className]} data-placeholder={file} style={`aspect-ratio:${ratio[0]} / ${ratio[1]}`} role="img" aria-label={`Screenshot to come: ${brief}`}>
    <p class="ph-tag">Placeholder</p>
    <p class="ph-name">{file}</p>
    <p class="ph-brief">{brief}</p>
  </div>
)}
