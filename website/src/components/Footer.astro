---
import { links, version, site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="wrap foot-grid">
    <div class="foot-about">
      <p class="foot-line">{site.tagline}</p>
      <p>A free Mac menu bar app for finding, pointing and drawing with your cursor while you share your screen. Made by <a class="link" href={links.author}>Walid Zakan</a>.</p>
    </div>
    <nav class="foot-col" aria-label="Project">
      <p class="foot-h">Project</p>
      <a class="link" href={links.download}>Download</a>
      <a class="link" href={links.repo}>Source code</a>
      <a class="link" href={links.releases}>Releases</a>
      <a class="link" href={links.changelog}>Changelog</a>
      <a class="link" href={links.issues}>Report an issue</a>
      <a class="link" href={links.license}>MIT licence</a>
    </nav>
    <nav class="foot-col" aria-label="On this page">
      <p class="foot-h">This page</p>
      <a class="link" href="/#tour">Tour</a>
      <a class="link" href="/#sharing">What viewers see</a>
      <a class="link" href="/#install">Install</a>
      <a class="link" href="/#privacy">Privacy</a>
      <a class="link" href="/#faq">FAQ</a>
    </nav>
  </div>
  <div class="wrap foot-base">
    <p>Version {version}, for macOS {site.minimumMacOS} or later. The app has no analytics and no cookies. This site counts visits with Cloudflare Web Analytics, which sets no cookies.</p>
    <p>&copy; {year} Walid Zakan. MIT licence; the name, icon and artwork are not covered.</p>
  </div>
</footer>
