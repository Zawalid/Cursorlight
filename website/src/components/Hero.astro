---
import Shot from './Shot.astro';
import { links, version, site } from '../data/site';
import { handLoop } from '../data/ink';

const lines = [
  [{ w: 'Be' }, { w: 'seen' }],
  [{ w: 'wherever' }],
  [{ w: 'you' }, { w: 'point.', point: true }],
];
const ring = handLoop(200, 70, 188, 62, 8);
const tries = [
  { id: 'shake', name: 'Shake', text: 'Shake the mouse and a highlight finds your cursor.' },
  { id: 'hold', name: 'Hold', text: 'Press and hold, then move: a laser trail follows.' },
  { id: 'draw', name: 'Drag', text: 'Click and drag to draw. Circle a word and it snaps clean.' },
];
---
<section class="hero" id="top" aria-labelledby="hero-title" data-hero data-gesture-zone data-surface="dark" data-mode="idle">
  <div class="wrap hero-pop-wrap"><div class="hero-pop"><Shot id="popover" sizes="300px" widths={[300, 600]} loading="eager" /></div></div>

  <div class="wrap hero-grid">
    <h1 id="hero-title" class="display hero-title">
      <span class="h-stack">
        <span class="h-base">
          {lines.map((line) => (
            <span class="h-line">
              {line.map((word, j) => (
                <><span class={word.point ? 'h-point' : undefined}>{word.w}{word.point && (
                  <svg class="h-ring" viewBox="0 0 400 140" preserveAspectRatio="none" aria-hidden="true"><path d={ring} /></svg>
                )}</span>{j < line.length - 1 ? ' ' : ''}</>
              ))}{' '}
            </span>
          ))}
        </span>
      </span>
    </h1>

    <div class="hero-foot">
      <div class="hero-pitch">
        <p class="lead">A free Mac menu bar app. Find your cursor, point with a laser, draw on the screen, light up one region. For calls, streams and talks.</p>
        <div class="hero-actions">
          <a class="btn btn-ember" href={links.download} data-hero-download>
            Download for macOS
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 3.5v11m0 0 4.5-4.5M10 14.5 5.5 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a class="btn btn-line" href={links.repo}>Source on GitHub</a>
        </div>
        <p class="fine">Version {version}. macOS {site.minimumMacOS} or later, Apple silicon and Intel. Free, open source, MIT.</p>
      </div>

      <div class="hero-try" data-no-draw>
        <p class="try-lead"><span class="only-live">This page is a small web version of it. Try it with your mouse.</span><span class="only-static">What it does on your Mac:</span></p>
        <ol class="tries">
          {tries.map((t) => (
            <li data-try={t.id}>
              <span class="try-mark" aria-hidden="true"></span>
              <span class="try-text"><strong>{t.name}.</strong> {t.text}<span class="sr-only only-live-sr" data-try-state> Not tried yet.</span></span>
            </li>
          ))}
        </ol>
        <p class="try-done only-live" data-try-done>That is all of it. Keys H, L, I and S in the bar below do the same, anywhere on this page.</p>
      </div>
    </div>
  </div>
  <p class="sr-only" role="status" aria-live="polite" data-hero-status></p>
</section>
