---
import Mark from './Mark.astro';

// A shared drawing of a Mac desktop: menu bar, an editor window, the Dock, and the effects Cursorlight draws on top.
const dock = ['#4aa3ff', '#6c5ce7', '#2ec4b6', '#ffb020', '#ef476f', '#7bd88f', '#c8b6ff'];
---
<section class="section sharing" id="sharing" aria-labelledby="sharing-title" data-surface="paper" data-iris data-sharing>
  <div class="wrap">
    <div class="sharing-head">
      <h2 id="sharing-title" class="h2">What your viewers see.</h2>
      <p class="lead">
        Cursorlight draws on your display, on top of your apps. Share the <Mark kind="loop" seed={6}>whole screen</Mark> and viewers get the
        display, effects included. Share <Mark kind="line" seed={2}>one window</Mark> and they get that window and nothing drawn on top of it. That is
        how macOS captures a window, and no setting in the app can change it.
      </p>
    </div>

    <div class="switch" role="group" aria-label="What you share">
      <button type="button" class="seg" data-share-set="screen" aria-pressed="true">Whole screen</button>
      <button type="button" class="seg" data-share-set="window" aria-pressed="false">One window</button>
    </div>

    <div class="stage" data-share-stage data-share="screen">
      <figure class="side">
        <svg viewBox="0 0 480 300" role="img" aria-labelledby="you-t you-d">
          <title id="you-t">What you see</title>
          <desc id="you-d">Your display with a code editor window, a menu bar and a Dock. An ember highlight ring on the cursor, a laser trail and a circle of ink are drawn on top. A dashed outline shows what you are sharing.</desc>
          <g class="scr">
            <rect class="d-wall" x="4" y="4" width="472" height="292" rx="14" />
            <rect class="d-menu" x="4" y="4" width="472" height="15" rx="14" />
            <rect class="d-menu-fill" x="4" y="12" width="472" height="7" />
            <circle class="d-dot" cx="16" cy="11.5" r="2.4" /><rect class="d-pill" x="26" y="9.5" width="30" height="4" rx="2" /><rect class="d-pill" x="62" y="9.5" width="22" height="4" rx="2" />
            <g>
              <rect class="d-win" x="46" y="40" width="288" height="196" rx="9" />
              <rect class="d-bar" x="46" y="40" width="288" height="20" rx="9" /><rect class="d-bar-fill" x="46" y="52" width="288" height="8" />
              <circle fill="#ff5f57" cx="58" cy="50" r="3" /><circle fill="#febc2e" cx="68" cy="50" r="3" /><circle fill="#28c840" cx="78" cy="50" r="3" />
              <rect class="d-side" x="46" y="60" width="62" height="176" />
              <g class="d-code">
                <rect x="122" y="76" width="44" height="6" rx="3" fill="#e06c9f" /><rect x="170" y="76" width="70" height="6" rx="3" fill="#8ab4ff" />
                <rect x="134" y="94" width="60" height="6" rx="3" fill="#7bd88f" /><rect x="198" y="94" width="96" height="6" rx="3" fill="#9a93a6" />
                <rect x="134" y="112" width="110" height="6" rx="3" fill="#9a93a6" /><rect x="248" y="112" width="40" height="6" rx="3" fill="#ffb020" />
                <rect x="146" y="130" width="84" height="6" rx="3" fill="#8ab4ff" /><rect x="234" y="130" width="58" height="6" rx="3" fill="#9a93a6" />
                <rect x="146" y="148" width="120" height="6" rx="3" fill="#9a93a6" />
                <rect x="134" y="166" width="70" height="6" rx="3" fill="#e06c9f" /><rect x="208" y="166" width="50" height="6" rx="3" fill="#7bd88f" />
                <rect x="122" y="184" width="36" height="6" rx="3" fill="#e06c9f" /><rect x="162" y="184" width="100" height="6" rx="3" fill="#9a93a6" />
              </g>
            </g>
            <rect class="d-dock" x="150" y="262" width="180" height="26" rx="9" />
            {dock.map((c, i) => <rect x={160 + i * 24} y="266" width="18" height="18" rx="5" fill={c} />)}
          </g>
          <g class="fx">
            <ellipse class="ink" cx="200" cy="132" rx="62" ry="22" />
            <path class="laser" d="M334 236 C 356 216, 378 196, 402 170 S 424 150, 436 140" />
            <circle class="aura" cx="440" cy="136" r="26" />
            <path class="arrow" d="M435 124 l0 25 l7 -6 l5 12 l5 -2 l-5 -12 l9 -1z" />
          </g>
          <rect class="select sel-screen" x="2" y="2" width="476" height="296" rx="16" />
          <rect class="select sel-window" x="40" y="34" width="300" height="208" rx="12" />
        </svg>
        <figcaption>On your Mac: the ring, the laser and the ink.</figcaption>
      </figure>

      <figure class="side">
        <svg viewBox="0 0 480 300" role="img" aria-labelledby="them-t them-d">
          <title id="them-t">What viewers see</title>
          <desc id="them-d" data-share-desc>Viewers see the whole display, including the ring, the laser and the ink.</desc>
          <g class="them-screen">
            <rect class="d-wall" x="4" y="4" width="472" height="292" rx="14" />
            <rect class="d-menu" x="4" y="4" width="472" height="15" rx="14" />
            <rect class="d-menu-fill" x="4" y="12" width="472" height="7" />
            <circle class="d-dot" cx="16" cy="11.5" r="2.4" /><rect class="d-pill" x="26" y="9.5" width="30" height="4" rx="2" /><rect class="d-pill" x="62" y="9.5" width="22" height="4" rx="2" />
            <rect class="d-win" x="46" y="40" width="288" height="196" rx="9" />
            <rect class="d-bar" x="46" y="40" width="288" height="20" rx="9" /><rect class="d-bar-fill" x="46" y="52" width="288" height="8" />
            <circle fill="#ff5f57" cx="58" cy="50" r="3" /><circle fill="#febc2e" cx="68" cy="50" r="3" /><circle fill="#28c840" cx="78" cy="50" r="3" />
            <rect class="d-side" x="46" y="60" width="62" height="176" />
            <g class="d-code">
              <rect x="122" y="76" width="44" height="6" rx="3" fill="#e06c9f" /><rect x="170" y="76" width="70" height="6" rx="3" fill="#8ab4ff" />
              <rect x="134" y="94" width="60" height="6" rx="3" fill="#7bd88f" /><rect x="198" y="94" width="96" height="6" rx="3" fill="#9a93a6" />
              <rect x="134" y="112" width="110" height="6" rx="3" fill="#9a93a6" /><rect x="248" y="112" width="40" height="6" rx="3" fill="#ffb020" />
              <rect x="146" y="130" width="84" height="6" rx="3" fill="#8ab4ff" /><rect x="234" y="130" width="58" height="6" rx="3" fill="#9a93a6" />
              <rect x="146" y="148" width="120" height="6" rx="3" fill="#9a93a6" />
              <rect x="134" y="166" width="70" height="6" rx="3" fill="#e06c9f" /><rect x="208" y="166" width="50" height="6" rx="3" fill="#7bd88f" />
              <rect x="122" y="184" width="36" height="6" rx="3" fill="#e06c9f" /><rect x="162" y="184" width="100" height="6" rx="3" fill="#9a93a6" />
            </g>
            <rect class="d-dock" x="150" y="262" width="180" height="26" rx="9" />
            {dock.map((c, i) => <rect x={160 + i * 24} y="266" width="18" height="18" rx="5" fill={c} />)}
            <g class="fx them-fx">
              <ellipse class="ink" cx="200" cy="132" rx="62" ry="22" />
              <path class="laser" d="M334 236 C 356 216, 378 196, 402 170 S 424 150, 436 140" />
              <circle class="aura" cx="440" cy="136" r="26" />
              <path class="arrow" d="M435 124 l0 25 l7 -6 l5 12 l5 -2 l-5 -12 l9 -1z" />
            </g>
          </g>
          <g class="them-window">
            <rect class="d-void" x="4" y="4" width="472" height="292" rx="14" />
            <svg x="70" y="26" width="340" height="248" viewBox="46 40 288 196" preserveAspectRatio="xMidYMid meet">
              <rect class="d-win" x="46" y="40" width="288" height="196" rx="9" />
              <rect class="d-bar" x="46" y="40" width="288" height="20" rx="9" /><rect class="d-bar-fill" x="46" y="52" width="288" height="8" />
              <circle fill="#ff5f57" cx="58" cy="50" r="3" /><circle fill="#febc2e" cx="68" cy="50" r="3" /><circle fill="#28c840" cx="78" cy="50" r="3" />
              <rect class="d-side" x="46" y="60" width="62" height="176" />
              <g class="d-code">
                <rect x="122" y="76" width="44" height="6" rx="3" fill="#e06c9f" /><rect x="170" y="76" width="70" height="6" rx="3" fill="#8ab4ff" />
                <rect x="134" y="94" width="60" height="6" rx="3" fill="#7bd88f" /><rect x="198" y="94" width="96" height="6" rx="3" fill="#9a93a6" />
                <rect x="134" y="112" width="110" height="6" rx="3" fill="#9a93a6" /><rect x="248" y="112" width="40" height="6" rx="3" fill="#ffb020" />
                <rect x="146" y="130" width="84" height="6" rx="3" fill="#8ab4ff" /><rect x="234" y="130" width="58" height="6" rx="3" fill="#9a93a6" />
                <rect x="146" y="148" width="120" height="6" rx="3" fill="#9a93a6" />
                <rect x="134" y="166" width="70" height="6" rx="3" fill="#e06c9f" /><rect x="208" y="166" width="50" height="6" rx="3" fill="#7bd88f" />
                <rect x="122" y="184" width="36" height="6" rx="3" fill="#e06c9f" /><rect x="162" y="184" width="100" height="6" rx="3" fill="#9a93a6" />
              </g>
            </svg>
          </g>
        </svg>
        <figcaption data-share-cap>On their screen: everything you see.</figcaption>
      </figure>
    </div>

    <p class="verdict" aria-live="polite" data-share-verdict><strong>Whole screen:</strong> every effect reaches viewers.</p>

    <div class="check">
      <h3 class="h3">So the app tells you before you start.</h3>
      <p>
        The share-safe check asks what you are sharing and warns you when viewers will not see your effects. It is a reminder, not a
        detector: you tell Cursorlight, and it keeps you from drawing circles nobody can see. The floating toolbar can also hide itself from
        the share, so it is yours alone.
      </p>
      <p class="tip">If viewers need to see your pointer, share the screen, not a window.</p>
    </div>
  </div>
</section>
